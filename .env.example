# MongoDB Connection String (e.g. mongodb://localhost:27017/darkchat or MongoDB Atlas connection string)
MONGODB_URI=mongodb://localhost:27017/darkchat

# Server Port
PORT=5001

# Client URL (for CORS in development, e.g. http://localhost:5173)
CLIENT_URL=http://localhost:5173

# Node Environment ('development' or 'production')
NODE_ENV=development
